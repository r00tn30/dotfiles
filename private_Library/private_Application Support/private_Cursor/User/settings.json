{
  "editor.detectIndentation": true,
  "editor.formatOnPaste": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "files.insertFinalNewline": true,
  "[python]": {
    "editor.rulers": [72, 79],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnType": true,
  },
  "python.analysis.typeCheckingMode": "standard",
  "files.autoSave": "onFocusChange",
  "workbench.colorTheme": "Tokyo Night AltSynt",
  "cSpell.userWords": [
    "cftest",
    "chdir",
    "defaulthostgroup",
    "hieradata",
    "hostgroup",
    "hostgroups",
    "hostvars",
    "mapclass",
    "pilotproduction",
    "puppetdev",
    "puppetlabs",
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.inlineSuggest.enabled": true,
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "AREPL.defaultFilterTypes": [
    "<class 'typing._SpecialForm'>",
    "<class 'typing._SpecialGenericAlias'>",
    "<class 'module'>",
    "<class 'function'>",
    "<class 'builtin_function_or_method'>",
  ],
  "AREPL.pythonOptions": ["-u"],
  "editor.formatOnSave": true,
  "settingsSync.ignoredSettings": ["-C_Cpp.codeAnalysis.maxMemory"],
  "workbench.settings.applyToAllProfiles": [],
  "application.shellEnvironmentResolutionTimeout": 30,
  "git.confirmSync": false,
  "editor.fontSize": 15,
  "editor.fontFamily": "JetBrains Mono",
  "editor.accessibilitySupport": "on",
  "accessibility.signalOptions.volume": 0,
  "vscode_custom_css.imports": [
    "file:///Users/s0m01cp/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js",
  ],
  "editor.fontLigatures": false,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "cursorpyright.analysis.typeCheckingMode": "standard",
  "git.autofetch": true,
  "makefile.configureOnOpen": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "window.autoDetectColorScheme": false,
  "extensions.installCooldownHours": 48,
}
